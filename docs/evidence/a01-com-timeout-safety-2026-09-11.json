  "scope": "Public COM timeout/cancel safety and timeout error semantics",
  "root_cause": {
    "old_behavior": "A timed-out COM call could continue on the old STA executor while the backend created a new executor generation, allowing later mutations to dispatch concurrently; a second mutation could also queue before the timeout latch was set.",
    "impact": "Blind retry or concurrent client requests could double-apply or overlap writes after unknown completion.",
    "audit_finding": "A-01"
  },
  "controls": {
    "single_sta_executor_after_timeout": true,
    "async_mutation_gate_before_executor_submit": true,
    "unknown_completion_latch": true,
    "queued_mutation_fenced_before_dispatch": true,
    "cancel_after_dispatch_latches_quarantine": true,
    "late_completion_does_not_clear_quarantine": true,
    "read_only_calls_allowed_for_reconciliation": true,
    "read_only_timeout_retryable": true,
    "mutation_timeout_retryable": false,
    "completion_unknown_exposed_in_public_error_contract": true,
    "document_new_or_open_cannot_clear_quarantine": true,
